/// A server-level service registry (the equivalent of Bukkit's
/// `ServicesManager`).
///
/// Because plugins run in isolated sandboxes, a "service" is discovered by
/// name here and invoked through the IPC interface: a provider registers a
/// service name, and consumers look the provider up and message it with
/// `send-ipc-message`.
interface services {
    /// One registration entry in the service registry.
    record service-provider {
        /// The service capability name.
        service: string,
        /// The plugin providing the service.
        plugin: string,
        /// Priority among multiple providers; higher values win.
        priority: s32,
    }

    /// Registers this plugin as a provider of `service`.
    ///
    /// Re-registering the same service from the same plugin updates its
    /// priority. The registration is removed automatically when the plugin is
    /// unloaded or disabled.
    ///
    /// * `service`: The service capability name (conventionally namespaced,
    ///   e.g. `my-plugin:economy`).
    /// * `priority`: Priority among multiple providers; higher values win.
    register-service: func(service: string, priority: s32) -> result<_, string>;

    /// Removes this plugin's registration for `service`.
    unregister-service: func(service: string);

    /// Returns the highest-priority active provider of `service`, if any.
    get-service-provider: func(service: string) -> option<service-provider>;

    /// Returns all active providers of `service`, sorted by descending
    /// priority (then registration order).
    get-service-providers: func(service: string) -> list<service-provider>;
}
