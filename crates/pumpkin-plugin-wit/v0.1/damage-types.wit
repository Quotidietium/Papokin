package pumpkin:plugin@0.1.0;

interface damage-types {
  enum damage-type {
    arrow,
    bad-respawn-point,
    cactus,
    campfire,
    cramming,
    dragon-breath,
    drown,
    dry-out,
    ender-pearl,
    explosion,
    fall,
    falling-anvil,
    falling-block,
    falling-stalactite,
    fireball,
    fireworks,
    fly-into-wall,
    freeze,
    generic,
    generic-kill,
    hot-floor,
    in-fire,
    in-wall,
    indirect-magic,
    lava,
    lightning-bolt,
    mace-smash,
    magic,
    mob-attack,
    mob-attack-no-aggro,
    mob-projectile,
    on-fire,
    out-of-world,
    outside-border,
    player-attack,
    player-explosion,
    sonic-boom,
    spear,
    spit,
    stalagmite,
    starve,
    sting,
    sulfur-cube-hot,
    sweet-berry-bush,
    thorns,
    thrown,
    trident,
    unattributed-fireball,
    wind-charge,
    wither,
    wither-skull,
  }

  /// When the damage amount scales with the server difficulty.
  enum damage-scaling {
    /// The damage amount never scales with difficulty.
    never,
    /// The damage amount scales only when the damage was caused by a living,
    /// non-player entity.
    when-caused-by-living-non-player,
    /// The damage amount always scales with difficulty.
    always,
  }

  /// Optional hurt sound/visual effect override of a damage type.
  enum damage-effects {
    hurt,
    thorns,
    drowning,
    burning,
    poking,
    freezing,
  }

  /// How the death message of a damage type is composed.
  enum death-message-type {
    /// The standard death message.
    %default,
    /// Fall damage style variants.
    fall-variants,
    /// The "intentional game design" message with a click event.
    intentional-game-design,
  }

  /// Represents a custom damage type definition registered by a plugin.
  record custom-damage-type {
    /// Namespaced id of the entry, e.g. "my_plugin:frost".
    name: string,
    /// Death message id; death messages translate as `death.attack.<message-id>`.
    message-id: string,
    /// When the damage amount scales with difficulty.
    scaling: damage-scaling,
    /// Exhaustion applied to players taking this damage.
    exhaustion: f32,
    /// Optional hurt sound/visual effect override.
    effects: option<damage-effects>,
    /// How the death message is composed.
    death-message-type: death-message-type,
  }

  /// Global manager for registering and querying custom damage types.
  ///
  /// Registration is only possible while the server is starting up (plugin
  /// loading); once the registries are frozen `register-damage-type` returns
  /// an error.
  resource damage-type-manager {
    /// Registers a new custom damage type with the server.
    register-damage-type: func(damage-type: custom-damage-type) -> result<_, string>;

    /// Gets a registered custom damage type by its namespaced name
    /// (e.g. "my_plugin:frost").
    get-damage-type: func(name: string) -> option<custom-damage-type>;

    /// Checks if a custom damage type name is registered.
    has-damage-type: func(name: string) -> bool;

    /// Returns the names of all registered custom damage types, in
    /// registration order.
    get-all-custom-damage-type-names: func() -> list<string>;
  }
}
