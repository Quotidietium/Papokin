/// Read-only combat tracker queries for living entities.
///
/// Every living entity keeps a combat tracker recording the damage entries of
/// its current combat episode, kill credit, and combat state. The query
/// functions live on the `living-entity` resource in the `world` interface;
/// this interface carries the shared record type.
interface combat {
    /// A single recorded damage event in an entity's combat history.
    record combat-entry {
        /// The damage type name: the vanilla message id (e.g. "arrow") or the
        /// namespaced registration name of a plugin-registered custom damage
        /// type (e.g. "myplugin:frost").
        damage-type: string,
        /// The amount of damage dealt to the victim's health/absorption.
        damage: f32,
        /// The victim's fall distance when the damage was recorded.
        fall-distance: f32,
        /// The entity id of the direct damage source (e.g. the arrow), if any.
        source-id: option<s32>,
        /// The entity id of the credited attacker (the cause, falling back to
        /// the source), if any.
        attacker-id: option<s32>,
        /// The attacker's display name rendered as plain console text, if any.
        attacker-name: option<string>,
        /// The custom name of the item in the attacker's main hand when the
        /// hit landed, if any.
        attacker-item-name: option<string>,
        /// Whether the credited attacker was a player.
        attacker-is-player: bool,
        /// The recording timestamp in milliseconds. Derived from the world
        /// tick clock at 20 ticks per second (1 tick = 50 ms).
        timestamp-ms: s64,
    }
}
