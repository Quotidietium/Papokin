/// Plugin messaging channels (the equivalent of Bukkit's `Messenger`).
///
/// Plugins register the clientbound channels they handle; incoming messages
/// from players on those channels are dispatched to the plugin's
/// `handle-plugin-message` export. Messages to players are sent directly on a
/// channel. Custom channels conventionally use the `plugin:channel` format;
/// vanilla namespaced channels (`minecraft:*`) cannot be registered.
interface messaging {
    /// Registers an incoming channel handled by this plugin.
    ///
    /// Messages received from players on this channel are dispatched to this
    /// plugin's `handle-plugin-message` export. Registering the same channel
    /// twice is a no-op.
    ///
    /// # Errors
    /// Returns an error when the channel is reserved (`minecraft:*`) or
    /// invalid.
    register-incoming-channel: func(channel: string) -> result<_, string>;

    /// Unregisters a previously registered incoming channel.
    unregister-incoming-channel: func(channel: string);

    /// Returns the incoming channels registered by this plugin.
    get-incoming-channels: func() -> list<string>;

    /// Sends a plugin message to a player on the given channel (Java Edition
    /// players only; Bedrock players receive nothing).
    ///
    /// # Errors
    /// Returns an error when the player is not online or the channel is
    /// invalid.
    send-plugin-message: func(player-uuid: string, channel: string, data: list<u8>) -> result<_, string>;
}
