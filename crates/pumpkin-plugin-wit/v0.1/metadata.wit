/// Plugin metadata describing the plugin and its compatibility.
interface metadata {
    /// When a plugin should be loaded relative to server startup.
    ///
    /// `startup` plugins are loaded before any world is created (bootstrap
    /// phase) and must not touch worlds or players during `on-load`;
    /// `post-world` plugins are loaded after the worlds are ready (default).
    variant load-order {
        /// Load before worlds are created (bootstrap phase).
        startup,
        /// Load after worlds are ready (default).
        post-world,
    }

    record plugin-metadata {
        /// Name of the plugin.
        name: string,
        /// Plugin version (semver).
        version: string,
        /// Plugin authors.
        authors: list<string>,
        /// Short description of the plugin.
        description: string,
        /// Hard dependencies: the plugin fails to load when any of these is missing.
        dependencies: list<string>,
        /// Permissions requested by the plugin.
        permissions: list<string>,
        /// Soft dependency edges: load this plugin after the named plugins when
        /// they are present. Missing names are ignored.
        load-after: list<string>,
        /// Soft ordering edges: load this plugin before the named plugins when
        /// they are present. Missing names are ignored.
        load-before: list<string>,
        /// Capability aliases this plugin satisfies: other plugins may reference
        /// these names in `dependencies` / `load-after` / `load-before` instead
        /// of the provider's concrete name.
        provides: list<string>,
        /// The startup phase this plugin loads in.
        load-order: load-order,
    }

    get-metadata: func() -> plugin-metadata;
}
