interface merchant {
    use %world.{entity};
    use item-stack.{item-stack};

    /// A single merchant trade offer: one entry in a villager's or wandering
    /// trader's trade list.
    ///
    /// The item stacks inside a `trade-offer` are snapshots. Mutating a stack
    /// obtained from `get-trade-offers` does not write back to the entity;
    /// pass the offer to `set-trade-offers` / `add-trade-offer` to apply it.
    record trade-offer {
        /// The primary cost stack of the trade (before demand/special-price
        /// adjustments are applied by the client).
        base-cost-a: item-stack,
        /// The stack the player receives.
        output: item-stack,
        /// The optional secondary cost stack.
        cost-b: option<item-stack>,
        /// Whether completing the trade spawns experience orbs.
        reward-exp: bool,
        /// How many times this offer has been used since the last restock.
        uses: s32,
        /// How many times this offer can be used before it is out of stock.
        max-uses: s32,
        /// Merchant experience the trade grants (villager trading xp).
        xp: s32,
        /// Special price modifier applied to `base-cost-a` (e.g. reputation
        /// discounts); added to the displayed first cost.
        special-price: s32,
        /// Demand price multiplier for `base-cost-a`.
        price-multiplier: f32,
        /// Demand value driving dynamic price adjustments.
        demand: s32,
    }

    /// A trading view over an entity that can trade (villager, wandering
    /// trader).
    ///
    /// All mutations re-send the offer list to the player currently trading
    /// with the entity, on both editions (Java `ClientboundMerchantOffers`
    /// and Bedrock `UpdateTrade`).
    resource merchant {
        /// Returns a merchant handle when `entity` can trade (a villager or a
        /// wandering trader), `none` otherwise.
        from-entity: static func(entity: borrow<entity>) -> option<merchant>;

        /// Returns a snapshot of the merchant's current trade offers.
        get-trade-offers: func() -> list<trade-offer>;

        /// Replaces all trade offers with `offers` and re-sends them to the
        /// trading player.
        set-trade-offers: func(offers: list<trade-offer>);

        /// Appends one trade offer and re-sends the offer list to the trading
        /// player.
        add-trade-offer: func(offer: trade-offer);

        /// Removes the trade offer at `index` and re-sends the offer list to
        /// the trading player. Returns `false` when `index` is out of bounds.
        remove-trade-offer: func(index: s32) -> bool;
    }
}
