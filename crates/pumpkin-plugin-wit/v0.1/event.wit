    }

    record lightning-strike-event-data {
        position: position,
        is-effect: bool,
        cancelled: bool
    }

    /// Called when a beacon is activated (its tier goes from 0 to n).
    record beacon-activated-event-data {
        /// The player that activated the beacon.
        player: player,
        /// Position of the beacon block.
        block-pos: block-pos,
        /// Whether the event is cancelled.
        cancelled: bool
    }

    /// Called when a beacon is deactivated (its tier drops to 0).
    record beacon-deactivated-event-data {
        /// The player that deactivated the beacon, if any.
        player: option<player>,
        /// Position of the beacon block.
        block-pos: block-pos,
        /// Whether the event is cancelled.
        cancelled: bool
    }

    /// Called when the break progress of a block is updated for a player.
    record block-break-progress-update-event-data {
        /// The player breaking the block.
        player: player,
        /// Position of the block being broken.
        block-pos: block-pos,
        /// Current break progress from 0.0 to 1.0, or -1.0 when reset.
        progress: f32,
        /// Whether the event is cancelled.
        cancelled: bool
    }

    /// Called when a dispenser fails to dispense an item.
    record block-failed-dispense-event-data {
        /// Position of the dispenser block.
        block-pos: block-pos,
        /// The item that failed to be dispensed.
        item: item-stack,
        /// Whether the event is cancelled.
        cancelled: bool
    }

    /// Called when an item is inserted into a composter.
    record compost-item-event-data {
        /// The player composting the item, if any (hoppers can compost too).
        player: option<player>,
        /// Position of the composter block.
        block-pos: block-pos,
        /// The item being composted.
        item: item-stack,
        /// Whether the compost level will be raised.
        will-raise-level: bool,
        /// Whether the event is cancelled.
        cancelled: bool
    }

    /// Called when a target block is hit by a projectile or entity.
    record target-hit-event-data {
        /// The entity that hit the target, if any.
        shooter-id: option<s32>,
        /// Position of the target block.
        block-pos: block-pos,
        /// The redstone signal strength emitted (0-15).
        signal-strength: s32,
        /// Whether the event is cancelled.
        cancelled: bool
    }

    /// The possible states of a vault block.
    enum vault-state {
        inactive,
        active,
        unlocking,
        ejecting,
    }

    /// Called when a vault block changes state.
    record vault-change-state-event-data {
        /// Position of the vault block.
        block-pos: block-pos,
        /// The state the vault is changing from.
        previous-state: vault-state,
        /// The state the vault is changing to.
        new-state: vault-state,
        /// Whether the event is cancelled.
        cancelled: bool
    }

    /// Called when a player's client finishes a tick.
    record client-tick-end-event-data {
        /// The player whose client tick ended.
        player: player
    }

    /// Called when a chunk is unloaded on the client of a player.
    record player-chunk-unload-event-data {
        /// The player the chunk is unloaded for.
        player: player,
        /// The world the chunk is in.
        target-world: %world,
        /// The X coordinate of the chunk.
        chunk-x: s32,
        /// The Z coordinate of the chunk.
        chunk-z: s32
    }

    /// Called when a player changes a sign before validation checks are applied.
    record unchecked-sign-change-event-data {
        /// The player editing the sign.
        player: player,
        /// Position of the sign block.
        block-pos: block-pos,
        /// The raw text lines of the sign.
        lines: list<string>,
        /// Whether the event is cancelled.
        cancelled: bool
    }

    /// The outcome of a login validation.
    enum connection-validation-result {
        allowed,
        denied,
    }

    /// Called when an incoming login is validated, allowing it to be denied early.
    record player-connection-validate-login-event-data {
        /// The IP address of the connecting client.
        ip-address: string,
        /// The kick message sent when the login is denied.
        kick-message: text-component,
        /// The validation result.
        %result: connection-validation-result
    }

    /// Called asynchronously when a player connection is being configured.
    record async-player-connection-configure-event-data {
        /// The name of the connecting player.
        player-name: string,
        /// The UUID of the connecting player.
        player-uuid: uuid,
        /// Whether the player joins for the first time.
        first-join: bool
    }

    /// Called when a player connection is initially configured.
    record player-connection-initial-configure-event-data {
        /// The name of the connecting player.
        player-name: string,
        /// The UUID of the connecting player.
        player-uuid: uuid,
        /// Whether the player joins for the first time.
        first-join: bool
    }

    /// Called when the server resources (data packs) are reloaded.
    record server-resources-reloaded-event-data {
        /// The cause of the reload (e.g. command or plugin).
        cause: string
    }

    /// The kind of whitelist state update.
    enum whitelist-state-update-status {
        added,
        removed,
    }

    /// Called when the whitelist state of a player is updated.
    record whitelist-state-update-event-data {
        /// The name of the target player.
        player-name: string,
        /// The UUID of the target player.
        player-uuid: uuid,
        /// The new whitelist status of the target.
        status: whitelist-state-update-status
    }

    /// Called when the server locates structures, e.g. for the locate command.
    record structures-locate-event-data {
        /// The world the search runs in.
        target-world: %world,
        /// The origin of the search.
        origin: block-pos,
        /// The identifier of the structure being located.
        structure: string,
        /// The search radius in chunks.
        radius: s32,
        /// The located structure positions (modifiable).
        results: list<block-pos>
    }

    /// Called when the difficulty of a world changes.
    record world-difficulty-change-event-data {
        /// The world whose difficulty changed.
        target-world: %world,
        /// The previous difficulty name.
        old-difficulty: string,
        /// The new difficulty name.
