    }

    /// The intention of a handshake.
    enum handshake-intention {
        status,
        login,
    }

    /// Called when a client sends a handshake packet.
    record player-handshake-event-data {
        /// The IP address of the client.
        ip-address: string,
        /// The hostname the client used to connect.
        hostname: string,
        /// The protocol version of the client.
        protocol-version: s32,
        /// The intention of the handshake (status or login).
        intention: handshake-intention,
        /// Whether the event is cancelled.
        cancelled: bool
    }

    /// Called when a witch finishes drinking a potion. Cancelling prevents
    /// the potion effects from being applied; the potion is still consumed.
    record witch-consume-potion-event-data {
        /// The witch drinking the potion.
        entity-id: s32,
        /// The potion being consumed.
        potion: item-stack,
        /// Whether the event is cancelled.
        cancelled: bool
    }

    /// Called when a witch raises a potion and starts drinking it.
    /// Cancelling prevents the drink; the potion is not equipped.
    record witch-ready-potion-event-data {
        /// The witch readying the potion.
        entity-id: s32,
        /// The potion being readied.
        potion: item-stack,
        /// Whether the event is cancelled.
        cancelled: bool
    }

    /// Called when a witch throws a splash potion at its target.
    /// Cancelling prevents the throw entirely.
    record witch-throw-potion-event-data {
        /// The witch throwing the potion.
        entity-id: s32,
        /// The splash potion being thrown.
        potion: item-stack,
        /// The entity the potion is thrown at, if any.
        target-id: option<s32>,
        /// Whether the event is cancelled.
        cancelled: bool
    }

