        cancelled: bool
    }

    record player-item-break-event-data {
        player: player,
        item-name: string
    }

    record player-item-mend-event-data {
        player: player,
        item-name: string,
        repair-amount: s32,
        exp-consumed: s32,
        cancelled: bool
    }

    record player-kick-event-data {
        player: player,
        reason: string,
        cancelled: bool
    }

