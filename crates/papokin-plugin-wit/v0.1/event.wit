    /// 当信标被激活（等级从 0 变为 n）时调用。
    record beacon-activated-event-data {
        /// 激活信标的玩家。
        player: player,
        /// 信标方块的位置。
        block-pos: block-pos,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当信标被停用（等级降为 0）时调用。
    record beacon-deactivated-event-data {
        /// 停用信标的玩家（如有）。
        player: option<player>,
        /// 信标方块的位置。
        block-pos: block-pos,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当玩家的方块破坏进度更新时调用。
    record block-break-progress-update-event-data {
        /// 正在破坏方块的玩家。
        player: player,
        /// 正在被破坏的方块位置。
        block-pos: block-pos,
        /// 当前破坏进度，从 0.0 到 1.0；重置时为 -1.0。
        progress: f32,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当发射器发射物品失败时调用。
    record block-failed-dispense-event-data {
        /// 发射器方块的位置。
        block-pos: block-pos,
        /// 发射失败的物品。
        item: item-stack,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当物品被投入堆肥桶时调用。
    record compost-item-event-data {
        /// 进行堆肥的玩家（如有；漏斗也能堆肥）。
        player: option<player>,
        /// 堆肥桶方块的位置。
        block-pos: block-pos,
        /// 被堆肥的物品。
        item: item-stack,
        /// 堆肥层数是否会提升。
        will-raise-level: bool,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当标靶方块被弹射物或实体击中时调用。
    record target-hit-event-data {
        /// 击中标靶的实体（如有）。
        shooter-id: option<s32>,
        /// 标靶方块的位置。
        block-pos: block-pos,
        /// 发出的红石信号强度（0-15）。
        signal-strength: s32,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 宝库方块的可能状态。
    enum vault-state {
        inactive,
        active,
        unlocking,
        ejecting,
    }

    /// 当宝库方块改变状态时调用。
    record vault-change-state-event-data {
        /// 宝库方块的位置。
        block-pos: block-pos,
        /// 宝库改变前的状态。
        previous-state: vault-state,
        /// 宝库改变后的状态。
        new-state: vault-state,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当玩家的客户端完成一刻时调用。
    record client-tick-end-event-data {
        /// 客户端刻结束的玩家。
        player: player
    }

    /// 当区块在玩家的客户端上卸载时调用。
    record player-chunk-unload-event-data {
        /// 区块为其卸载的玩家。
        player: player,
        /// 区块所在的世界。
        target-world: %world,
        /// 区块的 X 坐标。
        chunk-x: s32,
        /// 区块的 Z 坐标。
        chunk-z: s32
    }

    /// 当玩家修改告示牌时调用，先于校验检查。
    record unchecked-sign-change-event-data {
        /// 正在编辑告示牌的玩家。
        player: player,
        /// 告示牌方块的位置。
        block-pos: block-pos,
        /// 告示牌的原始文本行。
        lines: list<string>,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 登录校验的结果。
    enum connection-validation-result {
        allowed,
        denied,
    }

    /// 当传入的登录被校验时调用，允许提前拒绝。
    record player-connection-validate-login-event-data {
        /// 正在连接的客户端 IP 地址。
        ip-address: string,
        /// 登录被拒绝时发送的踢出消息。
        kick-message: text-component,
        /// 校验结果。
        %result: connection-validation-result
    }

    /// 当玩家连接正在被配置时异步调用。
    record async-player-connection-configure-event-data {
        /// 正在连接的玩家名。
        player-name: string,
        /// 正在连接的玩家 UUID。
        player-uuid: uuid,
        /// 玩家是否首次加入。
        first-join: bool
    }

    /// 当玩家连接被初始配置时调用。
    record player-connection-initial-configure-event-data {
        /// 正在连接的玩家名。
        player-name: string,
        /// 正在连接的玩家 UUID。
        player-uuid: uuid,
        /// 玩家是否首次加入。
        first-join: bool
    }

    /// 当服务器资源（数据包）被重载时调用。
    record server-resources-reloaded-event-data {
        /// 重载的原因（如命令或插件）。
        cause: string
    }

    /// 白名单状态更新的种类。
    enum whitelist-state-update-status {
        added,
        removed,
    }

    /// 当玩家的白名单状态更新时调用。
    record whitelist-state-update-event-data {
        /// 目标玩家名。
        player-name: string,
        /// 目标玩家的 UUID。
        player-uuid: uuid,
        /// 目标的新白名单状态。
        status: whitelist-state-update-status
    }

    /// 当服务器定位结构时调用，例如 locate 命令。
    record structures-locate-event-data {
        /// 执行搜索的世界。
        target-world: %world,
        /// 搜索的起点。
        origin: block-pos,
        /// 被定位结构的标识符。
        structure: string,
        /// 搜索半径（区块）。
        radius: s32,
        /// 定位到的结构位置（可修改）。
        results: list<block-pos>
    }

    /// 当世界的难度改变时调用。
    record world-difficulty-change-event-data {
        /// 难度发生改变的世界。
        target-world: %world,
        /// 之前的难度名称。
        old-difficulty: string,
        /// 新的难度名称。
        new-difficulty: string
    }

    /// 当世界中的游戏规则值改变时调用。
    record world-game-rule-change-event-data {
        /// 游戏规则发生改变的世界。
        target-world: %world,
        /// 游戏规则名称。
        rule: string,
        /// 游戏规则的新值。
        value: string,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当世界边界的范围（直径）改变时调用。
    record world-border-bounds-change-event-data {
        /// 边界发生改变的世界。
        target-world: %world,
        /// 旧直径（方块）。
        old-diameter: f64,
        /// 新直径（方块）。
        new-diameter: f64,
        /// 调整大小所需的时间（毫秒）。
        duration-ms: u64,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当世界边界的中心改变时调用。
    record world-border-center-change-event-data {
        /// 边界中心发生改变的世界。
        target-world: %world,
        /// 旧中心位置。
        old-center: position,
        /// 新中心位置。
        new-center: position,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 尝试猛击的结果。
    enum smash-attack-result {
        allowed,
        denied,
    }

    /// 当实体（如手持重锤的玩家）尝试猛击时调用。
    record entity-attempt-smash-attack-event-data {
        /// 尝试猛击的实体。
        entity-id: s32,
        /// 猛击的目标实体。
        target-id: s32,
        /// 尝试的结果。
        %result: smash-attack-result
    }

    /// 当实体手持或穿戴的物品受到耐久损耗时调用。
    record entity-damage-item-event-data {
        /// 物品受损的实体。
        entity-id: s32,
        /// 受损的物品。
        item: item-stack,
        /// 对物品造成的耐久损耗量。
        damage: s32,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 每刻对实体上每个生效的药水效果调用。
    record entity-effect-tick-event-data {
        /// 效果正在作用的实体。
        entity-id: s32,
        /// 效果类型的标识符。
        effect-type: string,
        /// 效果的等级增幅。
        amplifier: s32,
        /// 效果的剩余时长（刻）。
        duration: s32,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当实体某槽位的装备改变时调用。
    record entity-equipment-changed-event-data {
        /// 装备发生改变的实体。
        entity-id: s32,
        /// 发生改变的装备槽位。
        slot: string,
        /// 槽位中之前的物品（如有）。
        old-item: option<item-stack>,
        /// 槽位中现在的物品（如有）。
        new-item: option<item-stack>
    }

    /// 当实体（海龟）产下受精蛋时调用。
    record entity-fertilize-egg-event-data {
        /// 产蛋的实体。
        entity-id: s32,
        /// 繁殖该实体的玩家（如有）。
        breeder: option<player>,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当实体位于方块内部时，每刻调用。
    record entity-inside-block-event-data {
        /// 位于方块内部的实体。
        entity-id: s32,
        /// 实体所在方块的位置。
        block-pos: block-pos,
        /// 实体所在方块的名称。
        block-name: string
    }

    /// 当实体为弩装填弹射物时调用。
    record entity-load-crossbow-event-data {
        /// 正在装填弩的实体。
        entity-id: s32,
        /// 被装填的弩。
        crossbow: item-stack,
        /// 被装填的弹射物物品。
        projectiles: list<item-stack>,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当实体移动时调用。
    record entity-move-event-data {
        /// 发生移动的实体。
        entity-id: s32,
        /// 实体移动前的位置。
        from-position: position,
        /// 实体移动后的位置。
        to-position: position
    }

    /// 当实体切换坐下状态时调用。
    record entity-toggle-sit-event-data {
        /// 切换坐下状态的实体。
        entity-id: s32,
        /// 实体现在是否坐着。
        sitting: bool,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当运输物品的实体校验其目标方块时调用。
    record item-transporting-entity-validate-target-event-data {
        /// 运输中的实体。
        entity-id: s32,
        /// 被校验的目标方块位置。
        target-pos: block-pos,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当可驯服实体死亡并生成其死亡消息时调用。
    record tameable-death-message-event-data {
        /// 死亡的可驯服实体。
        entity-id: s32,
        /// 要广播的死亡消息。
        death-message: text-component
    }

    /// 当水瓶溅射到实体时调用。
    record water-bottle-splash-event-data {
        /// 被投掷的药水实体。
        entity-id: s32,
        /// 受溅射影响的实体。
        affected-entities: list<s32>,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当苦力怕被点燃时调用。
    record creeper-ignite-event-data {
        /// 被点燃的苦力怕。
        entity-id: s32,
        /// 点燃苦力怕的实体（如有）。
        igniter-id: option<s32>,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当末影龙喷吐龙息、生成区域效果云时调用。
    record ender-dragon-flame-event-data {
        /// 末影龙实体。
        entity-id: s32,
        /// 龙息产生的区域效果云。
        area-effect-cloud-id: s32,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当末影人攻击玩家时调用。
    record enderman-attack-player-event-data {
        /// 发起攻击的末影人。
        entity-id: s32,
        /// 被攻击的玩家。
        player: player,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当末影人逃离战斗时调用。
    record enderman-escape-event-data {
        /// 逃离的末影人。
        entity-id: s32,
        /// 逃离原因（如传送或未知）。
        reason: string,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当实体跳跃时调用。
    record entity-jump-event-data {
        /// 跳跃的实体。
        entity-id: s32
    }

    /// 当实体开始向目标寻路时调用。
    record entity-pathfind-event-data {
        /// 正在寻路的实体。
        entity-id: s32,
        /// 寻路的目标实体（如有）。
        target-id: option<s32>,
        /// 计算出的路径，以位置列表表示。
        path: list<position>,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当实体通过末地折跃门传送时调用。
    record entity-teleport-end-gateway-event-data {
        /// 正在传送的实体。
        entity-id: s32,
        /// 末地折跃门方块的位置。
        gateway: block-pos,
        /// 实体传送前的位置。
        from-position: position,
        /// 实体传送后的位置。
        to-position: position,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当实体被闪电击中时调用。
    record entity-zap-event-data {
        /// 被闪电击中的实体。
        entity-id: s32,
        /// 闪电实体。
        lightning-id: s32,
        /// 被击中的原因。
        cause: string,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当生物在玩家周围自然生成时调用。
    record player-naturally-spawn-creatures-event-data {
        /// 生物在其周围生成的玩家。
        player: player,
        /// 生成区块的 X 坐标。
        chunk-x: s32,
        /// 生成区块的 Z 坐标。
        chunk-z: s32,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 在生物生成前调用，允许提前过滤。
    record pre-creature-spawn-event-data {
        /// 生成位置。
        position: position,
        /// 生物生成的世界。
        target-world: %world,
        /// 正在生成的实体类型标识符。
        entity-type: string,
        /// 生成原因。
        reason: string,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 在刷怪笼生成实体前调用。
    record pre-spawner-spawn-event-data {
        /// 刷怪笼方块的位置。
        spawner-pos: block-pos,
        /// 正在生成的实体类型标识符。
        entity-type: string,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当掷出的鸡蛋判定是否孵化时调用。
    record thrown-egg-hatch-event-data {
        /// 鸡蛋实体。
        egg-id: s32,
        /// 鸡蛋是否会孵化。
        will-hatch: bool,
        /// 从鸡蛋中孵出的实体数量。
        num-hatches: u8,
        /// 孵出的实体类型标识符。
        hatching-type: string
    }

    /// 当玩家上床失败时调用。
    record player-bed-fail-enter-event-data {
        /// 上床失败的玩家。
        player: player,
        /// 床方块的位置。
        bed-pos: block-pos,
        /// 上床失败的原因。
        fail-reason: string,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当玩家修改信标的效果时调用。
    record player-change-beacon-effect-event-data {
        /// 修改信标效果的玩家。
        player: player,
        /// 主效果标识符（如有）。
        primary-effect: option<string>,
        /// 副效果标识符（如有）。
        secondary-effect: option<string>,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当玩家进入深度睡眠时调用。
    record player-deep-sleep-event-data {
        /// 进入深度睡眠的玩家。
        player: player
    }

    /// 当玩家操作花盆的内容物时调用。
    record player-flower-pot-manipulate-event-data {
        /// 操作花盆的玩家。
        player: player,
        /// 花盆方块的位置。
        block-pos: block-pos,
        /// 被放入花盆或从花盆取出的物品。
        item: item-stack,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当玩家将书放入讲台时调用。
    record player-insert-lectern-book-event-data {
        /// 放书的玩家。
        player: player,
