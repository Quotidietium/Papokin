        block-pos: block-pos,
        /// 被放入的书。
        book: item-stack,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当玩家物品栏槽位中的物品改变时调用。
    record player-inventory-slot-change-event-data {
        /// 物品栏发生改变的玩家。
        player: player,
        /// 发生改变的物品栏槽位。
        slot: s32,
        /// 槽位中之前的物品（如有）。
        old-item: option<item-stack>,
        /// 槽位中现在的物品（如有）。
        new-item: option<item-stack>
    }

    /// 当玩家的某物品类型被施加冷却时调用。
    record player-item-cooldown-event-data {
        /// 被施加冷却的玩家。
        player: player,
        /// 物品类型的标识符。
        item-type: string,
        /// 冷却时长（刻）。
        cooldown: s32,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 对物品展示框执行的操作。
    enum item-frame-action {
        place,
        remove,
        rotate,
    }

    /// 当玩家在物品展示框中放置、移除或旋转物品时调用。
    record player-item-frame-change-event-data {
        /// 与物品展示框交互的玩家。
        player: player,
        /// 物品展示框实体。
        frame-id: s32,
        /// 操作涉及的物品。
        item: item-stack,
        /// 对物品展示框执行的操作。
        action: item-frame-action,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当玩家的物品冷却组被施加冷却时调用。
    record player-item-group-cooldown-event-data {
        /// 被施加冷却的玩家。
        player: player,
        /// 冷却组的标识符。
        cooldown-group: string,
        /// 冷却时长（刻）。
        cooldown: s32,
        /// 事件是否被取消。
        cancelled: bool
    }

