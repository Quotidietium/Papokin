        /// 是否启用聊天颜色。
        chat-colors: bool,
        /// 新的主手设置。
        main-hand: string,
        /// 新的皮肤可见部位位掩码。
        skin-parts: u32
    }

    /// 当玩家连接关闭时调用。
    record player-connection-close-event-data {
        /// 正在断开连接的玩家 UUID。
        player-uuid: uuid,
        /// 正在断开连接的玩家名。
        player-name: string,
        /// 正在断开连接的玩家 IP 地址。
        ip-address: string
    }

    /// 当铁砧因使用而受损时调用。
    record anvil-damaged-event-data {
        /// 使用铁砧的玩家。
        player: player,
        /// 铁砧方块的位置。
        block-pos: block-pos,
        /// 铁砧的新受损状态。
        damage-state: string,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当信标效果被施加到玩家时调用。
    record beacon-effect-event-data {
        /// 被施加效果的玩家。
        player: player,
        /// 被施加效果的标识符。
        effect: string,
        /// 该效果是否为信标的主效果。
        primary: bool,
        /// 信标方块的位置。
        block-pos: block-pos,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当命令建议被发送给玩家时异步调用。
    record async-player-send-suggestions-event-data {
        /// 接收建议的玩家。
        player: player,
        /// 当前命令缓冲区。
        buffer: string,
        /// 待发送的建议（可修改）。
        suggestions: list<string>,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当命令被注册到服务器时调用。
    record command-registered-event-data {
        /// 被注册命令的标签。
        command-label: string,
        /// 注册该命令的插件名。
        plugin: string
    }

    /// 当玩家跳跃时调用。
    record player-jump-event-data {
        /// 跳跃的玩家。
        player: player,
        /// 玩家起跳的位置。
        from-position: position,
        /// 玩家跳到的位置。
        to-position: position,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当玩家拾取经验球时调用。
    record player-pickup-experience-event-data {
        /// 拾取经验的玩家。
        player: player,
        /// 经验球实体。
        orb-id: s32,
        /// 拾取的经验量。
        amount: s32,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 在玩家重生后调用。
    record player-post-respawn-event-data {
        /// 重生的玩家。
        player: player,
        /// 玩家重生的位置。
        respawn-location: position,
        /// 重生位置是否为玩家的床重生点。
        is-bed-spawn: bool
    }

    /// 当玩家用弓搭箭时调用。
    record player-ready-arrow-event-data {
        /// 搭箭的玩家。
        player: player,
        /// 使用的弓。
        bow: item-stack,
        /// 搭上的箭。
        arrow: item-stack,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当玩家开始旁观实体时调用。
    record player-start-spectating-entity-event-data {
        /// 正在旁观的玩家。
        player: player,
        /// 被旁观的实体。
        target-id: s32,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当玩家停止旁观实体时调用。
    record player-stop-spectating-entity-event-data {
        /// 先前在旁观的玩家。
        player: player,
        /// 先前被旁观的实体。
        target-id: s32,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当玩家通过末地折跃门传送时调用。
    record player-teleport-end-gateway-event-data {
        /// 正在传送的玩家。
        player: player,
        /// 末地折跃门方块的位置。
        gateway: block-pos,
        /// 玩家传送前的位置。
        from-position: position,
        /// 玩家传送后的位置。
        to-position: position,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当玩家档案已填充其属性时调用。
    record fill-profile-event-data {
        /// 档案的 UUID。
        player-uuid: uuid,
        /// 档案名（若已解析）。
        player-name: option<string>,
        /// 档案属性，以名称/值对表示。
        properties: list<tuple<string, string>>
    }

    /// 在玩家档案被填充前调用，允许提供缓存的档案。
    record pre-fill-profile-event-data {
        /// 档案的 UUID。
        player-uuid: uuid,
        /// 档案名（若已知）。
        player-name: option<string>,
        /// 档案属性，以名称/值对表示。
        properties: list<tuple<string, string>>
    }

    /// 当按名称查询玩家档案时调用。
    record lookup-profile-event-data {
        /// 被查询的名称。
        name: string,
        /// 解析出的档案 UUID。
        player-uuid: uuid,
        /// 解析出的档案名（如有）。
        player-name: option<string>,
        /// 档案属性，以名称/值对表示。
        properties: list<tuple<string, string>>
    }

    /// 在按名称查询玩家档案前调用。
    record pre-lookup-profile-event-data {
        /// 被查询的名称。
        name: string
    }

    /// 白名单验证的结果。
    enum whitelist-verify-result {
        allowed,
        denied,
    }

    /// 当正在连接的玩家接受白名单验证时调用。
    record profile-whitelist-verify-event-data {
        /// 正在连接的玩家 UUID。
        player-uuid: uuid,
        /// 正在连接的玩家名。
        player-name: string,
        /// 玩家不在白名单时发送的踢出消息。
        kick-message: text-component,
        /// 验证结果。
        %result: whitelist-verify-result
    }

    /// 当 Tab 补全被计算时异步调用。
    record async-tab-complete-event-data {
        /// 请求补全的发送者（若为玩家）。
        sender: option<player>,
        /// 当前命令缓冲区。
        buffer: string,
        /// 计算出的补全项（可修改）。
        completions: list<string>,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当收到 GS4 Query 时调用。
    record gs4-query-event-data {
        /// Query 的类型。
        query-type: string,
        /// 查询方的地址。
        querier-address: string,
        /// 响应数据，以键/值对表示。
        data: list<tuple<string, string>>
    }

    /// 当白名单被开启或关闭时调用。
    record whitelist-toggle-event-data {
        /// 白名单现在是否启用。
        enabled: bool
    }

    /// 握手的意图。
    enum handshake-intention {
        status,
        login,
    }

    /// 当客户端发送握手数据包时调用。
    record player-handshake-event-data {
        /// 客户端的 IP 地址。
        ip-address: string,
        /// 客户端连接使用的主机名。
        hostname: string,
        /// 客户端的协议版本。
        protocol-version: s32,
        /// 握手的意图（status 或 login）。
        intention: handshake-intention,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当女巫喝完药水时调用。取消会阻止
    /// 药水效果被施加；药水仍会被消耗。
    record witch-consume-potion-event-data {
        /// 喝药水的女巫。
        entity-id: s32,
        /// 被消耗的药水。
        potion: item-stack,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当女巫举起药水并开始饮用时调用。
    /// 取消会阻止饮用；药水不会被装备。
    record witch-ready-potion-event-data {
        /// 举起药水的女巫。
        entity-id: s32,
        /// 被举起的药水。
        potion: item-stack,
        /// 事件是否被取消。
        cancelled: bool
    }

    /// 当女巫向目标投掷喷溅药水时调用。
    /// 取消会完全阻止投掷。
    record witch-throw-potion-event-data {
        /// 投掷药水的女巫。
        entity-id: s32,
        /// 被投掷的喷溅药水。
        potion: item-stack,
        /// 药水投掷的目标实体（如有）。
        target-id: option<s32>,
        /// 事件是否被取消。
        cancelled: bool
    }

